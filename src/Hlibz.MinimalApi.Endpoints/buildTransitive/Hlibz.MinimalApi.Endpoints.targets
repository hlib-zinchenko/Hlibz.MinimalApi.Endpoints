<Project>

  <!--
      MapEndpoints reads the endpoint list the package's source generator writes into every
      assembly holding endpoints, so each of them must compile with the generator, including a
      project that gets this package indirectly (through a project reference, or through another
      package such as Hlibz.MinimalApi.Endpoints.FluentValidation). The .NET 10 and 11 SDKs
      already hand it to such projects, even though pack declares package dependencies with
      exclude="Analyzers". This is the guard for a build that doesn't: it adds the generator only
      when it's missing, once.
  -->
  <Target Name="_HlibzMinimalApiEndpointsAddGenerator"
          AfterTargets="ResolvePackageDependenciesForBuild;ResolveNuGetPackageAssets">
    <ItemGroup>
      <_HlibzMinimalApiEndpointsGenerator Include="@(Analyzer)"
                                          Condition="'%(Filename)' == 'Hlibz.MinimalApi.Endpoints.Generators'" />
      <Analyzer Include="$(MSBuildThisFileDirectory)../analyzers/dotnet/cs/Hlibz.MinimalApi.Endpoints.Generators.dll"
                Condition="'@(_HlibzMinimalApiEndpointsGenerator)' == ''" />
    </ItemGroup>
  </Target>

</Project>
