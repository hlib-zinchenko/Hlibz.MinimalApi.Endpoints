<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <ItemGroup>
        <!--
            The minimum Hlibz.MinimalApi.Endpoints.FluentValidation supports, not the latest:
            packed as a ">= 11.0.0" dependency, so consumers pick any newer FluentValidation
            themselves, and the tests run against this minimum. Raise it only when the add-on
            needs a newer API (Dependabot ignores it).
        -->
        <PackageVersion Include="FluentValidation" Version="11.0.0" />
        <!--
            The Roslyn the source generator builds against, and so the oldest compiler that can
            load it: a deliberately low minimum (4.8), far below the .NET 10 SDK's, so every SDK
            that can build a net10.0 project loads it. Raise it only when the generator needs a
            newer Roslyn API (Dependabot ignores it).
        -->
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
        <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" />
        <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
        <PackageVersion Include="xunit.v3" Version="4.0.3" />
    </ItemGroup>

    <!-- Test-only: an in-memory server per ASP.NET Core major, matching each target framework. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.14" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
        <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="11.0.0" />
        <!-- Samples only (net11.0): the OpenAPI document showing what the endpoints document. -->
        <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
        <!-- Samples only: a ReDoc page rendering that document, at /api-docs. -->
        <PackageVersion Include="Hlibz.Redoc.AspNetCore" Version="2.3.0" />
        <!-- Samples only (Envelope.Api): Hlibz.Results' response envelope. -->
        <PackageVersion Include="Hlibz.Results.AspNetCore" Version="1.1.0" />
    </ItemGroup>
</Project>
