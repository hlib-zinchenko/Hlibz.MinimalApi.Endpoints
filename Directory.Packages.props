<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <ItemGroup>
        <!--
            The minimum Hlibz.MinimalApi.Endpoints.FluentValidation supports, not the latest:
            packed as a ">= 11.0.0" dependency, so consumers pick any newer FluentValidation
            themselves, and the tests run against this minimum. Raise it only when the add-on
            needs a newer API (Dependabot ignores it).
        -->
        <PackageVersion Include="FluentValidation" Version="11.0.0" />
        <!--
            The Roslyn the source generator builds against, and so the oldest compiler that can
            load it: a deliberately low minimum (4.8), far below the .NET 11 SDK's, so every SDK
            loads it. Raise it only when the generator needs a newer Roslyn API (Dependabot
            ignores it).
        -->
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
        <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.37.0.15768" />
        <PackageVersion Include="StyleCop.Analyzers" Version="1.3.180" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
        <PackageVersion Include="xunit.v3" Version="4.0.3" />
        <!-- Test-only: an in-memory server. -->
        <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="11.0.0" />
        <!-- Samples only: the OpenAPI document showing what the endpoints document. -->
        <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
        <!-- Samples only (Library.Api): a ReDoc page rendering that document, at /api-docs. -->
        <PackageVersion Include="Hlibz.Redoc.AspNetCore" Version="2.5.0" />
        <!-- Samples only (TypedErrors.Api): Hlibz.Results' responses and typed errors. -->
        <PackageVersion Include="Hlibz.Results.AspNetCore" Version="3.0.0-preview.1" />
    </ItemGroup>
</Project>
