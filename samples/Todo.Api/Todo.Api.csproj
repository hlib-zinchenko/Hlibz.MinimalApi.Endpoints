<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The XML summaries are what the OpenAPI document shows (Hlibz.OpenApi's AddXmlDocumentation),
    so this sample writes the XML file the other samples don't, and copies the packages' own
    (Hlibz.Results' ErrorResponse is described from it). A summary is all a sample type needs.
  -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CopyDocumentationFilesFromPackages>true</CopyDocumentationFilesFromPackages>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Hlibz.Redoc.AspNetCore" />
    <PackageReference Include="Hlibz.Results.AspNetCore" />
    <PackageReference Include="Hlibz.OpenApi.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <!-- In your own app: PackageReference Include="Hlibz.MinimalApi.Endpoints". -->
    <ProjectReference Include="..\..\src\Hlibz.MinimalApi.Endpoints\Hlibz.MinimalApi.Endpoints.csproj" />
  </ItemGroup>

  <!-- The source generator that lists the endpoints; in your own app the package brings it. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Hlibz.MinimalApi.Endpoints.Generators\Hlibz.MinimalApi.Endpoints.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
