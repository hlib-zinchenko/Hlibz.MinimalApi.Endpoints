  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Hlibz.Redoc.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <!-- In your own app: PackageReference Include="Hlibz.MinimalApi.Endpoints.FluentValidation". -->
    <ProjectReference Include="..\..\src\Hlibz.MinimalApi.Endpoints.FluentValidation\Hlibz.MinimalApi.Endpoints.FluentValidation.csproj" />
